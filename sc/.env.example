# InfoPilot Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# DEPLOYMENT CONFIGURATION
# ========================================

# Your private key for deployment (DO NOT commit actual private key!)
# Get testnet FLR from: https://faucet.flare.network/coston2
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Flarescan API key for contract verification (optional)
# Get from: https://coston2-explorer.flare.network/
FLARESCAN_API_KEY=YOUR_API_KEY_HERE

# ========================================
# NETWORK CONFIGURATION
# ========================================

# Coston2 Testnet RPC URLs
COSTON2_RPC_URL=https://coston2.enosys.global/ext/C/rpc
COSTON2_ALT_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Chain ID
COSTON2_CHAIN_ID=114

# ========================================
# FLARE PROTOCOL ADDRESSES (COSTON2)
# ========================================

# These are fixed addresses on Coston2 testnet
FTSO_V2_ADDRESS=0x7BDE3Df0624114eDB3A67dFe6753e62f4e7c1d20
FEED_CONVERTER_ADDRESS=0xafEa60cabb2daB413D17b85Db82cCf6EB06a0F66

# ========================================
# DEPLOYMENT ADDRESSES (After Deployment)
# ========================================

# Fill these in after running deployment
# FACTORY_ADDRESS=
# SENTIMENT_ORACLE_ADDRESS=
# DEX_ADDRESS=
# WFLR_ADDRESS=
# USDC_ADDRESS=
# USDT_ADDRESS=

# ========================================
# FRONTEND CONFIGURATION
# ========================================

# WalletConnect Project ID (for frontend)
# Get from: https://cloud.walletconnect.com/
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public RPC URL (for frontend)
# NEXT_PUBLIC_RPC_URL=https://coston2.enosys.global/ext/C/rpc

# ========================================
# NOTES
# ========================================

# 1. Never commit your actual private key
# 2. Get testnet FLR from: https://faucet.flare.network/coston2
# 3. Contract verification is optional but recommended
# 4. After deployment, addresses will be saved to deployments/coston2-latest.json
